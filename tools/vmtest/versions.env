# Pinned versions for the VM test environment.
# Single source of truth — sourced by the scripts and hashed for CI caching.
# Values are defaults: an environment variable with the same name wins, so a
# job can override e.g. LUNATIK_REF to test a new Lunatik reference.

# Linux LTS kernel the tests run against.
: "${KERNEL_VERSION:=6.18.35}"

# Lunatik source: upstream release tag, with the exact commit it must resolve
# to so a moved tag is detected. The fix_crypto_enomem branch of the fork is
# abandoned: its crypto preallocation fix (commit 95318191) is in v5.1.
: "${LUNATIK_REPO:=https://github.com/luainkernel/lunatik}"
: "${LUNATIK_REF:=v5.1}"
# `=` (not `:=`) so an explicitly empty value stays empty when testing an
# unpinned reference.
: "${LUNATIK_COMMIT=e9b48135f45ca8a950015a3ee7280d54368d09c4}"
